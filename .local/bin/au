#! /usr/bin/env bash

content=$(cat - | sed 's|"|\\"|g' )
cmd="${*}"
style="${STYLE:-no explanation,short,compact reply only,no bullshit,no hallucination}"
model=${MODEL:-gpt-oss:20b}

printf '{ "stream": false, "model": "%s", "prompt":"%s;%s;content: %s" }' "${model}" "${cmd}" "${style}" "${content}" \
  | curl -s -d@- ${OLLAMA_HOST:-http://localhost:11434}/api/generate \
  | fx '.response'

