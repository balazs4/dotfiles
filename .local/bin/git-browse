#! /usr/bin/env bash

git_url=$(git config --get remote.${1:-origin}.url)
url=$git_url

case "$git_url" in
  *${REMOTE:-gitweb}*)
    url=$(printf '%s;a=tree' $(echo $git_url | sed 's|ssh://|https://|; s|~/|?p=|'))
    ;;

  *)
    url=$(printf 'http://%s' $(echo $git_url | sed 's|ssh://||; s|:|/|; s|git@||; s|\.git$||'))
    ;;
esac

printf "%s\n" $git_url $url
$BROWSER $url
