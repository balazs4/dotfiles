#! /usr/bin/env bash

case "${1:-help}" in
  "shotgun")
    geom=$(hacksaw -f "-i %i -g %g")
    shotgun ${geom} - | xclip -t 'image/png' -selection clipboard
    dunstify -t 2000 "shotgun" "copied to clipboard"
    ;;

  "setxkbmap")
    xkbmap=$(setxkbmap -query | awk '/layout/ {print $NF}')
    case "${xkbmap:-us}" in
      "us") setxkbmap de ;;
         *) setxkbmap us ;;
    esac
    pkill -SIGRTMIN+2 i3blocks
    dunstify -t 2000 "setxkbmap -query" "$(setxkbmap -query)"
    ;;

  "focus")
    id=$(i3-msg -t get_tree | fx i3windows | dmenu -i -l 24 | awk '{print $1}' )
    msg=$(printf '[con_id="%s"] focus' $id)
    i3-msg ${msg}
    ;;

  "webapp")
    webapp=$(printf '%s\n' "whatsapp" "microsoft" "google" "spotify" "bank" | dmenu -i -p webapp -sb "#{{base09-hex}}" -fn 'GeistMono-12')

    case "${webapp}" in
      "bank")      google-chrome-stable --user-data-dir=$HOME/.config/webapp/bank ;;
      "google")    google-chrome-stable --user-data-dir=$HOME/.config/webapp/google ;;
      "microsoft") google-chrome-stable --user-data-dir=$HOME/.config/webapp/microsoft  --app=https://outlook.com ;;
      "spotify")   chromium --app=https://open.spotify.com ;;
      "whatsapp")  chromium --app=https://web.whatsapp.com ;;
      *) dunstify -t 5000 "${webapp}" "unknown webapp" ;;
    esac
    ;;


  "help")
    printf "xbind %s\n" "shotgun|setxkbmap"
    ;;
esac
