#! /usr/bin/env bash

case "${1:-help}" in
  "shotgun")
    geom=$(hacksaw -f "-i %i -g %g")
    shotgun ${geom} - | xclip -t 'image/png' -selection clipboard
    dunstify -t 2000 "shotgun" "copied to clipboard"
    ;;

  "setxkbmap")
    xkbmap=$(setxkbmap -query | awk '/layout/ {print $NF}')
    case "${xkbmap:-us}" in
      "us") setxkbmap de ;;
         *) setxkbmap us ;;
    esac
    pkill -SIGRTMIN+2 i3blocks
    dunstify -t 2000 "setxkbmap -query" "$(setxkbmap -query)"
    ;;

  "focus")
    id=$(i3-msg -t get_tree | fx i3windows | dmenu -i -l 24 | awk '{print $1}' )
    msg=$(printf '[con_id="%s"] focus' $id)
    i3-msg ${msg}
    ;;

  "webapp")
    webapp=$(printf '%s\n' "whatsapp" "chromium" "google" "bank" | dmenu -i -p webapp -sb "#{{base09-hex}}" -fn 'GeistMono-12')

    case "${webapp}" in
      "bank")      google-chrome-stable --user-data-dir=$HOME/.config/webapp/bank ;;
      "google")    google-chrome-stable --user-data-dir=$HOME/.config/webapp/google ;;
      "whatsapp")  google-chrome-stable --user-data-dir=$HOME/.config/webapp/google --app=https://web.whatsapp.com ;;
      "chromium")  chromium ;;
    esac
    ;;


  "now")
    line_index=0
    while IFS= read -r line
    do
      case $line_index in
        0) track_name=$line ;;
        1) artist_name=$line ;;
        2) art_url=$line ;;
      esac
      (( line_index++ ))
    done <<< $(mpris-ctl info '%track_name\n%artist_name\n%art_url')

    searchterm=$(node -p "encodeURIComponent('$artist_name $track_name'.trim())")
    [[ $art_url ]] && curl -s $art_url -o /tmp/$searchterm.png

    if [[ ! -f /tmp/$searchterm.png ]]
    then
      curl -D /dev/stderr -Lisk "https://api.deezer.com/search?strict=on&q=$searchterm" \
        | fx 'x => x.data.map(xx => xx.album.cover_medium).join("\n")' \
        | head -1 \
        | xargs -I{} curl -s {} -o /tmp/$searchterm.png
    fi

    dunstify -I /tmp/$searchterm.png "$track_name" "$artist_name"
    ;;


  "help")
    printf "xbind %s\n" "shotgun|setxkbmap"
    ;;
esac
