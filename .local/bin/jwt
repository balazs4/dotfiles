#! /usr/bin/env bash

node -e "
  const [header, payload, signature] = '${1:-`cat`}'.split('.').map(x => Buffer.from(x, 'base64').toString());
  const jwt = {header: JSON.parse(header), payload: JSON.parse(payload)};
  process.stdout.write(JSON.stringify(jwt,null,2));
  process.stdout.write('\n');

  process.stderr.write('iat:');
  process.stderr.write(new Date(1000 * jwt.payload.iat).toJSON());
  process.stderr.write('\n');
  process.stderr.write('exp:');
  process.stderr.write(new Date(1000 * jwt.payload.exp).toJSON());
  process.stderr.write('\n');
"
