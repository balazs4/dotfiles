"pulsemixer --change-volume +5           && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:123
    XF86AudioRaiseVolume

"pulsemixer --change-volume -5           && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:122
    XF86AudioLowerVolume

"pulsemixer --toggle-mute                && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:121
    XF86AudioMute

"pulsemixer --toggle-mute --id source-7  && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:198
    XF86AudioMicMute

"xbacklight -25"
    m:0x0 + c:232
    XF86MonBrightnessDown

"xbacklight +25"
    m:0x0 + c:233
    XF86MonBrightnessUp

"alacritty"
    m:0x40 + c:36
    Mod4 + Return

"chromium"
    m:0x40 + c:54
    Mod4 + c

"dmenu_run -i -sb '#{{base0D-hex}}' -fn 'GeistMono-12'"
    m:0x40 + c:40
    Mod4 + d

"slock"
    m:0x40 + c:46
    Mod4 + l

"$HOME/.local/bin/xbind print"
    m:0x40 + c:107
    Mod4 + Print

