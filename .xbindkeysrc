"pulsemixer --change-volume +5           && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:123
    XF86AudioRaiseVolume

"pulsemixer --change-volume -5           && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:122
    XF86AudioLowerVolume

"pulsemixer --toggle-mute                && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:121
    XF86AudioMute

"pulsemixer --toggle-mute --id source-7  && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:198
    XF86AudioMicMute

"xbacklight -25"
    m:0x0 + c:232
    XF86MonBrightnessDown

"xbacklight +25"
    m:0x0 + c:233
    XF86MonBrightnessUp

"alacritty"
    m:0x40 + c:36
    Mod4 + Return

"chromium"
    m:0x40 + c:54
    Mod4 + c

"dmenu_run -i -sb '#{{base0D-hex}}' -fn 'GeistMono-12'"
    m:0x40 + c:40
    Mod4 + d

"$HOME/.local/bin/xbind webapp"
    m:0x41 + c:40
    Shift+Mod4 + d

"slock"
    m:0x40 + c:46
    Mod4 + l

"$HOME/.local/bin/xbind shotgun"
    m:0x40 + c:107
    Mod4 + Print

"$HOME/.local/bin/xbind setxkbmap"
    m:0x0 + c:224
    XF86Messenger

"$HOME/.local/bin/xbind focus"
    m:0x40 + c:65
    Mod4 + space

"$HOME/.local/bin/xbind now"
    m:0x40 + c:51
    Mod4 + backslash

"playerctl play-pause"
    m:0x40 + c:105
    Mod4 + Control_R

"playerctl previous"
    m:0x40 + c:112
    Mod4 + Prior

"playerctl next"
    m:0x40 + c:117
    Mod4 + Next

"dunstify -t 1000 XF86Go"
    m:0x0 + c:226
    XF86Go

"dunstify -t 1000 Cancel"
    m:0x0 + c:231
    Cancel

"dunstify -t 1000 XF86Favorites"
    m:0x0 + c:164
    XF86Favorites

