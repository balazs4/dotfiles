"alacritty"
    m:0x40 + c:36
    Mod4 + Return

"chromium"
    m:0x40 + c:54
    Mod4 + c

"dmenu_run -i -sb '#{{base0D-hex}}' -fn 'GeistMono-12'"
    m:0x40 + c:40
    Mod4 + d

"$HOME/.local/bin/xbind webapp"
    m:0x41 + c:40
    Shift+Mod4 + d

"slock"
    m:0x40 + c:46
    Mod4 + l

"$HOME/.local/bin/xbind shotgun"
    m:0x40 + c:107
    Mod4 + Print

"$HOME/.local/bin/xbind setxkbmap"
    m:0x0 + c:164
    XF86Favorites

"$HOME/.local/bin/xbind focus"
    m:0x40 + c:65
    Mod4 + space

"$HOME/.local/bin/xbind now"
    m:0x40 + c:51
    Mod4 + backslash

"mpris-ctl --player active --player inactive pp"
    m:0x40 + c:105
    Mod4 + Control_R

"mpris-ctl --player active previous"
    m:0x40 + c:112
    Mod4 + Prior

"mpris-ctl --player active next"
    m:0x40 + c:117
    Mod4 + Next


