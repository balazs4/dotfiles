"pulsemixer --change-volume +5           && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:123
    XF86AudioRaiseVolume

"pulsemixer --change-volume -5           && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:122
    XF86AudioLowerVolume

"pulsemixer --toggle-mute                && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:121
    XF86AudioMute

"pulsemixer --toggle-mute --id source-7  && pkill -SIGRTMIN+1 i3blocks"
    m:0x0 + c:198
    XF86AudioMicMute

#carbon "xbacklight -dec 15"
#carbon     m:0x0 + c:232
#carbon     XF86MonBrightnessDown
#carbon 
#carbon "xbacklight -dec 5"
#carbon     m:0x4 + c:116
#carbon     Control + Down
#carbon 
#carbon "xbacklight -inc 15"
#carbon     m:0x0 + c:233
#carbon     XF86MonBrightnessUp
#carbon 
#carbon "xbacklight -inc 5"
#carbon     m:0x4 + c:111
#carbon     Control + Up

#carbon "xrandr --output DP1 --off --output DP2 --off --output HDMI1 --off --output eDP1 --mode 1920x1080 --pos 0x0 --rotate normal --primary"
