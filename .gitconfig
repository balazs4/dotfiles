[user]
  name  = balazs4
  email = balazs4@{{hostname}}
  signingkey = ~/.ssh/id_ed25519.pub
[gpg]
  format = ssh
[commit]
  gpgSign = true
  verbose = true
[push]
  autoSetupRemote = true
[fetch]
  prune = true
  prunteTags = true
[pull]
  rebase = true
[init]
  defaultBranch = main
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[merge]
  conflictStyle = zdiff3
[includeIf "hasconfig:remote.*.url:*github.com*/**"]
  path = ~/.gitconfig.github.com
[includeIf "hasconfig:remote.*.url:*gitlab.com*/**"]
  path = ~/.gitconfig.gitlab.com
[includeIf "hasconfig:remote.*.url:*codeberg.org*/**"]
  path = ~/.gitconfig.codeberg.org
[includeIf "hasconfig:remote.*.url:ssh://git@git.sr.ht*/**"]
  path = ~/.gitconfig.sr.ht
