[advice]
  defaultBranchName = false
[user]
  name  = balazs4
  email = balazs4@{{hostname}}
[commit]
  verbose = true
[push]
  autoSetupRemote = true
[fetch]
  prune = true
  prunteTags = true
[pull]
  rebase = true
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[merge]
  conflictStyle = zdiff3
[merge]
  tool = vimdiff
[alias]
  pull = pull --prune --tags
  browse = ~/.local/bin/git-browse
[includeIf "hasconfig:remote.*.url:*github.com*/**"]
  path = ~/.gitconfig.github.com
[includeIf "hasconfig:remote.*.url:*gitlab.com*/**"]
  path = ~/.gitconfig.gitlab.com
[includeIf "hasconfig:remote.*.url:*codeberg.org*/**"]
  path = ~/.gitconfig.codeberg.org
[includeIf "hasconfig:remote.*.url:**/git.sr.ht/**"]
  path = ~/.gitconfig.sr.ht
